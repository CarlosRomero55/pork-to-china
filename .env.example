# Copia este archivo como .env y completa los valores EN TU PC.
# Nunca subas .env a GitHub ni pegues estos valores en un chat.

# --- MySQL 8 ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Usuario de solo lectura para la app de Streamlit y la API (lo crea db_setup)
BI_USER=pork_bi
BI_PASSWORD=

# Nombres de los esquemas Medallion (puedes dejarlos así)
DB_BRONZE=pork_bronze
DB_SILVER=pork_silver
DB_GOLD=pork_gold

# --- APIs ---
# Llave gratuita en https://comtradeplus.un.org (Profile > Subscriptions > comtrade - v1)
COMTRADE_API_KEY=
# Llave gratuita en https://apps.fas.usda.gov/opendatawebv2/ (opcional)
USDA_FAS_API_KEY=

# --- Ejecución ---
LOG_LEVEL=INFO
START_YEAR=2018
